{
  "name": "yfm13db",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "validate:data": "node scripts/validate-data.mjs",
    "validate:images": "node scripts/validate-images.mjs",
    "validate:duelist-images": "node scripts/validate-duelist-images.mjs",
    "data:extract": "python \"scripts/mod13/extract-mod13.py\"",
    "data:cards": "python \"scripts/mod13/import-card-metadata.py\"",
    "data:images": "python \"scripts/mod13/import-card-images.py\"",
    "data:duelist-images": "python \"scripts/mod13/import-duelist-images.py\"",
    "data:fm2-ghost:cards": "python \"scripts/fm2 ghost/import_tea_card_metadata.py\"",
    "data:fm2-ghost:drops": "python \"scripts/fm2 ghost/import_tea_drop_fallbacks.py\"",
    "data:fm2-ghost:rituals": "python \"scripts/fm2 ghost/import_tea_rituals.py\"",
    "data:fm2-ghost:equips": "python \"scripts/fm2 ghost/import_tea_equips.py\"",
    "data:fm2-ghost:images": "python \"scripts/fm2 ghost/normalize_ghost_card_images.py\" --apply",
    "data:fm2-ghost:duelist-images": "python \"scripts/fm2 ghost/normalize_ghost_duelist_images.py\" --apply"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.0.9"
  }
}
